rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BriefCraft AI internal tool rules
    match /clients/{clientId} {
      allow read, write: if true;
      
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
    
    // Resumable pipeline checkpoint storage
    match /pipeline_jobs/{jobId} {
      allow read, write: if true;
    }
    
    // Proactive rate limit daily counters (reset at Pacific midnight)
    match /rate_limits/{docId} {
      allow read, write: if true;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
