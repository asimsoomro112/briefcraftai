rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BriefCraft AI is an internal tool for a freelance web developer.
    // There is no public sign-up; all client briefs and prompts are restricted
    // strictly to the authenticated developer.
    match /clients/{clientId} {
      allow read, write: if request.auth != null;
      
      match /prompts/{promptId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
